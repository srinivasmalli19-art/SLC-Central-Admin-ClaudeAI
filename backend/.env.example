# SLC Central Admin — backend environment variables.
# Copy this file to .env and fill in real values for your machine.
# NEVER commit a real .env file. See docs/ARCHITECTURE.md / INTEGRATION-STRATEGY.md
# for why no application-specific secrets belong here in Phase 1.

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (Central Admin's own Postgres — never an integrated app's DB) ---
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/slc_central_admin_dev"

# --- Auth (self-hosted JWT for Phase 1 — see docs/PHASE-1-IMPLEMENTATION.md) ---
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-never-committed
JWT_EXPIRES_IN=8h

# --- Bootstrap (used only by prisma/seed.ts to create the first Super Admin) ---
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-before-seeding
SEED_SUPER_ADMIN_NAME="Super Admin"

# --- Logging ---
LOG_LEVEL=info

# --- Pasumithra integration adapter (Phase 4, read-only) ---
# See docs/PASUMITHRA-ADAPTER.md "Credential architecture" for the full
# rationale. This project's Google Cloud organization enforces
# iam.disableServiceAccountKeyCreation — no downloadable service-account
# JSON key is used or requested. Leave everything below unset and the
# integration simply reports a "configuration_error" health status instead
# of crashing the rest of Central Admin.
PASUMITHRA_FIREBASE_PROJECT_ID=pasumithra-adc10

# PASUMITHRA_FIREBASE_AUTH_MODE selects exactly one credential mechanism —
# required (whenever the Firestore emulator isn't in use); never guessed or
# silently defaulted, so a misconfiguration is always visible as a
# configuration_error rather than a confusing auth failure.
#
#   adc              (recommended) Google Application Default Credentials —
#                     no private key of any kind. Local dev:
#                     `gcloud auth application-default login`, ideally
#                     impersonating the existing least-privilege service
#                     account (see docs/PASUMITHRA-ADAPTER.md) so your own
#                     Google account never needs a direct Firestore grant:
#                       gcloud auth application-default login \
#                         --impersonate-service-account=<service-account-email>
#                     On Google Cloud (Cloud Run/GCE/Cloud Functions),
#                     attach that same service account to the compute
#                     resource — no key, no extra config. Outside Google
#                     Cloud (e.g. Render), point GOOGLE_APPLICATION_CREDENTIALS
#                     at a Workload Identity Federation config file (not a
#                     private key — safe to store as a normal config value).
#   service_account   Kept as a supported fallback, unchanged from before —
#                     requires PASUMITHRA_FIREBASE_CLIENT_EMAIL and
#                     PASUMITHRA_FIREBASE_PRIVATE_KEY below. Not usable in
#                     this project without a JSON key, which the
#                     organization policy above disables — included only so
#                     the code path isn't removed for other environments
#                     where that policy doesn't apply.
PASUMITHRA_FIREBASE_AUTH_MODE=adc

# Only read when PASUMITHRA_FIREBASE_AUTH_MODE=service_account. Never share
# outside this backend's own secrets store — must never reach the frontend,
# a log line, or git.
PASUMITHRA_FIREBASE_CLIENT_EMAIL=replace-with-service-account-client-email
PASUMITHRA_FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key"
