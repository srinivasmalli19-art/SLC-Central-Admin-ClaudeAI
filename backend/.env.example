# SLC Central Admin — backend environment variables.
# Copy this file to .env and fill in real values for your machine.
# NEVER commit a real .env file. See docs/ARCHITECTURE.md / INTEGRATION-STRATEGY.md
# for why no application-specific secrets belong here in Phase 1.

# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (Central Admin's own Postgres — never an integrated app's DB) ---
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/slc_central_admin_dev"

# --- Auth (self-hosted JWT for Phase 1 — see docs/PHASE-1-IMPLEMENTATION.md) ---
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-never-committed
JWT_EXPIRES_IN=8h

# --- Bootstrap (used only by prisma/seed.ts to create the first Super Admin) ---
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-before-seeding
SEED_SUPER_ADMIN_NAME="Super Admin"

# --- Logging ---
LOG_LEVEL=info
