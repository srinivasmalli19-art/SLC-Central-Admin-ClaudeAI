{
  "name": "@slc-central-admin/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretest": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://$(whoami)@localhost:5432/slc_central_admin_test} npx prisma migrate deploy",
    "test": "vitest run --exclude tests/adapters/pasumithra/emulator/** --exclude tests/adapters/jeevamitra/emulator/**",
    "test:watch": "vitest",
    "test:pasumithra:emulator": "firebase emulators:exec --project demo-pasumithra-adc10 --config firebase-emulator/firebase.json \"vitest run tests/adapters/pasumithra/emulator\"",
    "test:jeevamitra:emulator": "firebase emulators:exec --project demo-jeevamitra --config firebase-emulator/firebase.json \"vitest run tests/adapters/jeevamitra/emulator\"",
    "lint": "eslint src tests --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase-admin": "^12.6.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
