# Dependencies
node_modules/
*/node_modules/

# Env / secrets — never commit real credentials
.env
.env.local
.env.*.local
!.env.example
!*/.env.example

# Defensive: never commit a service-account key or private key file by name,
# regardless of where it's dropped in the tree (e.g. a downloaded Firebase
# service-account JSON for the Pasumithra adapter — see
# docs/PASUMITHRA-ADAPTER.md). The adapter only ever reads credentials from
# environment variables, never from a file in this repo, so nothing should
# ever legitimately match these patterns.
*serviceAccount*.json
*service-account*.json
*-key.json
*.pem
*.p12
*.jks
*credentials*.json

# Build output
dist/
build/
*/dist/
*/build/

# Prisma
backend/prisma/dev.db
backend/prisma/dev.db-journal

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/
*/coverage/

# OS / editor
.DS_Store
.vscode/
.idea/

# Misc
*.tsbuildinfo
